// Copy this document and remove components that are not needed by the new case.
{
  // Simulation time step.
  "dt": 0.0001,
  "fluid": {
    "buffer_size": 1024,
    "particle_count": 2,
    "statistical_weight": 1.0,
    "materials": [
      {
        "type": "molecule", // molecule | atom | ion | neutron | solid
        "mass": 4.65e-26,
        "translational_energy": 0.0,
        "rotational_energy": 0.0,
        "vibrational_energy": 0.0,
        "reference_diameter": 4.17e-10,
        "reference_temperature": 273.0,
        "viscosity_index": 0.74,
        "scattering_parameter": 1.0
      }
    ],
    "position": [[-0.5, -0.1, 0.0], [-0.5, 0.1, 0.0]],
    "velocity": [[10.0, 0.0, 0.0], [10.0, 0.0, 0.0]],
    "species": [0, 0],
    "temperature": [300.0, 300.0],
    "translational_energy": [0.0, 0.0],
    "rotational_energy": [0.0, 0.0],
    "vibrational_energy": [0.0, 0.0]
  },
  "universe": {
    "lower_corner": [-1.0, -1.0, -1.0],
    "upper_corner": [1.0, 1.0, 1.0],
    // Use "geometry" instead of corners to derive the domain from a bound:
    // "geometry": {"type": "box", "lower_corner": [-1,-1,-1], "upper_corner": [1,1,1]},
    "cell_size": 0.25
    // Optional user-facing cell states contain exactly cell_count entries.
    // "temperature": [...],
    // "bulk_velocity": [[0,0,0], ...],
    // "field_force": [[0,0,0], ...],
    // "gravity": [[0,-9.81,0], ...],
    // "thermal_energy": [...],
    // "knudsen_number": [...]
  },
  "solvers": [
    {
      "kernel": "variable_hard_sphere", // hard_sphere | variable_hard_sphere | variable_soft_sphere
      "majorant_sample_pairs": 8,
      "majorant_exhaustive_limit": 5
    }
  ],
  "emitters": [
    {
      "source": {
        "type": "volume", // volume | surface
        "unit": {
          "geometry": {"type": "box", "lower_corner": [-0.9,-0.2,-0.2], "upper_corner": [-0.8,0.2,0.2]},
          "translation": [0.0, 0.0, 0.0],
          "orientation": [1.0, 0.0, 0.0, 0.0],
          "velocity": [0.0, 0.0, 0.0],
          "acceleration": [0.0, 0.0, 0.0],
          "angular_velocity": [0.0, 0.0, 0.0],
          "angular_acceleration": [0.0, 0.0, 0.0]
        },
        "spacing": 0.1,
        "tolerance": 0.0
      },
      "generator": {
        "type": "maxwell_boltzmann", // uniform | jittering | maxwell_sigma | maxwell_boltzmann
        "species_ratios": [1.0],
        "species_numbers": [0.0],
        "species_mass": [4.65e-26],
        "temperature": 300.0,
        "min_value": -1.0,
        "max_value": 1.0,
        "base_value": 0.0,
        "jitter_radius": 0.1,
        "sigma": 1.0,
        "bulk_velocity": [10.0, 0.0, 0.0],
        "seed": 1
      }
    }
  ],
  "colliders": [
    {
      "unit": {
        "geometry": {"type": "cylinder", "center": [0,0,0], "radius": 0.2, "height": 1.0, "open": true}
      },
      "momentum_accommodation_coefficient": 1.0,
      "restitution": 1.0,
      "diffuse_sampling": "uniform" // uniform | cosine_weighted
    }
  ],
  "sinks": [
    {"type": "volume", "unit": {"geometry": {"type": "sphere", "center": [0.8,0,0], "radius": 0.1}}, "tolerance": 0.0}
    // Surface and swept alternatives:
    // {"type": "surface", "unit": {"geometry": {"type": "plane", "normal": [1,0,0], "offset": 0.9}}},
    // {"type": "tracing", "unit": {"geometry": {"type": "square", "center": [0.9,0,0], "normal": [1,0,0], "side_length": 1.0}}}
  ],
  "codec": {
    "representative_characteristic_length": 1.0,
    "representative_collision_cross_sectional_area": 1.0,
    "representative_statistical_weight": 1.0,
    "representative_cell_volume": 1.0
  }

  // Geometry forms accepted anywhere a geometry appears:
  // {"type":"box", "lower_corner":[-1,-1,-1], "upper_corner":[1,1,1]}
  // {"type":"circle", "center":[0,0,0], "normal":[0,0,1], "radius":1}
  // {"type":"cylinder", "center":[0,0,0], "radius":1, "height":2, "open":false}
  // {"type":"plane", "normal":[0,1,0], "offset":0}
  // {"type":"sphere", "center":[0,0,0], "radius":1}
  // {"type":"square", "center":[0,0,0], "normal":[0,0,1], "side_length":1}
  // {"type":"triangle", "a":[0,0,0], "b":[1,0,0], "c":[0,1,0]}
  // {"type":"triangle_mesh", "triangles":[[[0,0,0],[1,0,0],[0,1,0]]]}
  // {"type":"polygonal_prism", "center":[0,0,0], "side_count":6, "radius":1, "height":2}
}
