{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ATLAS_LOGGING": "OFF",
        "ATLAS_GOOGLE_TEST": "OFF",
        "ATLAS_PYTHON": "OFF",
        "ATLAS_BENCHMARKS": "OFF",
        "ATLAS_EXAMPLES": "OFF",
        "ATLAS_HOST_COMPILER": "native"
      }
    },
    {
      "name": "debug-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ATLAS_LOGGING": "ON",
        "ATLAS_GOOGLE_TEST": "ON",
        "ATLAS_PYTHON": "ON",
        "ATLAS_BENCHMARKS": "ON",
        "ATLAS_EXAMPLES": "ON"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "tbb-debug",
      "displayName": "Atlas TBB Debug (CPU, native C++ compiler)",
      "inherits": "debug-base",
      "cacheVariables": {
        "ATLAS_DEVICE_SYSTEM": "TBB"
      }
    },
    {
      "name": "tbb-gcc-debug",
      "displayName": "Atlas TBB Debug (CPU, GCC/G++, no CUDA toolkit)",
      "inherits": "tbb-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "tbb-nvcc-debug",
      "displayName": "Atlas TBB Debug compiled by nvcc (CI guard)",
      "inherits": "debug-base",
      "cacheVariables": {
        "ATLAS_DEVICE_SYSTEM": "TBB",
        "ATLAS_HOST_COMPILER": "nvcc"
      }
    },
    {
      "name": "tbb-release",
      "displayName": "Atlas TBB Release (CPU, native C++ compiler)",
      "inherits": "release-base",
      "cacheVariables": {
        "ATLAS_DEVICE_SYSTEM": "TBB"
      }
    },
    {
      "name": "tbb-gcc-release",
      "displayName": "Atlas TBB Release (CPU, GCC/G++, no CUDA toolkit)",
      "inherits": "tbb-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "cuda-debug",
      "displayName": "Atlas CUDA Debug (GPU, Thrust device = CUDA)",
      "inherits": "debug-base",
      "cacheVariables": {
        "ATLAS_DEVICE_SYSTEM": "CUDA"
      }
    },
    {
      "name": "cuda-release",
      "displayName": "Atlas CUDA Release (GPU, Thrust device = CUDA)",
      "inherits": "release-base",
      "cacheVariables": {
        "ATLAS_DEVICE_SYSTEM": "CUDA"
      }
    }
  ],
  "testPresets": [
    {
      "name": "ctest-tbb-debug",
      "displayName": "CTest (TBB Debug)",
      "configurePreset": "tbb-debug",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ctest-tbb-gcc-debug",
      "displayName": "CTest (TBB Debug, GCC/G++)",
      "configurePreset": "tbb-gcc-debug",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ctest-cuda-debug",
      "displayName": "CTest (CUDA Debug)",
      "configurePreset": "cuda-debug",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ctest-tbb-nvcc-debug",
      "displayName": "CTest (TBB Debug, nvcc)",
      "configurePreset": "tbb-nvcc-debug",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
