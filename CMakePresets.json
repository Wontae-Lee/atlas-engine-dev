{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "ATLAS_LOGGING": "OFF",
        "ATLAS_GOOGLE_TEST": "OFF",
        "ATLAS_PYTHON": "OFF",
        "ATLAS_BENCHMARKS": "OFF",
        "ATLAS_EXAMPLES": "OFF",
        "ATLAS_INTERACTIVE": "OFF",
        "ATLAS_INTERACTIVE_RENDERING": "OFF",
        "ATLAS_HOST_COMPILER": "native"
      }
    },
    {
      "name": "debug-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ATLAS_LOGGING": "ON",
        "ATLAS_GOOGLE_TEST": "ON"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "tbb-debug",
      "displayName": "Atlas TBB Debug (CPU, native C++ compiler)",
      "inherits": "debug-base",
      "cacheVariables": {
        "ATLAS_DEVICE_SYSTEM": "TBB"
      }
    },
    {
      "name": "tbb-gcc-debug",
      "displayName": "Atlas TBB Debug (CPU, GCC/G++, no CUDA toolkit)",
      "inherits": "tbb-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "tbb-nvcc-debug",
      "displayName": "Atlas TBB Debug compiled by nvcc (CI guard)",
      "inherits": "debug-base",
      "cacheVariables": {
        "ATLAS_DEVICE_SYSTEM": "TBB",
        "ATLAS_HOST_COMPILER": "nvcc"
      }
    },
    {
      "name": "tbb-release",
      "displayName": "Atlas TBB Release (CPU, native C++ compiler)",
      "inherits": "release-base",
      "cacheVariables": {
        "ATLAS_DEVICE_SYSTEM": "TBB"
      }
    },
    {
      "name": "tbb-gcc-release",
      "displayName": "Atlas TBB Release (CPU, GCC/G++, no CUDA toolkit)",
      "inherits": "tbb-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "cuda-debug",
      "displayName": "Atlas CUDA Debug (GPU, Thrust device = CUDA)",
      "inherits": "debug-base",
      "cacheVariables": {
        "ATLAS_DEVICE_SYSTEM": "CUDA"
      }
    },
    {
      "name": "cuda-release",
      "displayName": "Atlas CUDA Release (GPU, Thrust device = CUDA)",
      "inherits": "release-base",
      "cacheVariables": {
        "ATLAS_DEVICE_SYSTEM": "CUDA"
      }
    },
    {
      "name": "tbb-application-release",
      "displayName": "Atlas TBB Native Applications",
      "inherits": "tbb-release",
      "cacheVariables": {
        "ATLAS_LOGGING": "ON",
        "ATLAS_EXAMPLES": "ON",
        "ATLAS_INTERACTIVE": "ON",
        "ATLAS_INTERACTIVE_RENDERING": "ON"
      }
    },
    {
      "name": "cuda-application-release",
      "displayName": "Atlas CUDA Native Applications",
      "inherits": "cuda-release",
      "cacheVariables": {
        "ATLAS_LOGGING": "ON",
        "ATLAS_EXAMPLES": "ON",
        "ATLAS_INTERACTIVE": "ON",
        "ATLAS_INTERACTIVE_RENDERING": "ON"
      }
    },
    {
      "name": "tbb-test",
      "displayName": "Atlas TBB complete native tests",
      "inherits": "tbb-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ATLAS_INTERACTIVE": "ON",
        "ATLAS_INTERACTIVE_RENDERING": "ON",
        "ATLAS_EXAMPLES": "ON",
        "ATLAS_BENCHMARKS": "ON"
      }
    },
    {
      "name": "cuda-test",
      "displayName": "Atlas CUDA complete native tests",
      "inherits": "cuda-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ATLAS_INTERACTIVE": "ON",
        "ATLAS_INTERACTIVE_RENDERING": "ON",
        "ATLAS_EXAMPLES": "ON",
        "ATLAS_BENCHMARKS": "ON"
      }
    }
  ],
  "testPresets": [
    {
      "name": "ctest-tbb-debug",
      "displayName": "CTest (TBB Debug)",
      "configurePreset": "tbb-debug",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ctest-tbb-gcc-debug",
      "displayName": "CTest (TBB Debug, GCC/G++)",
      "configurePreset": "tbb-gcc-debug",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ctest-cuda-debug",
      "displayName": "CTest (CUDA Debug)",
      "configurePreset": "cuda-debug",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ctest-tbb-nvcc-debug",
      "displayName": "CTest (TBB Debug, nvcc)",
      "configurePreset": "tbb-nvcc-debug",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tbb-test",
      "configurePreset": "tbb-test",
      "filter": {
        "include": {
          "name": "^(atlas_tests|atlas_tests_interactive|atlas_tests_interactive_rendering)\\."
        }
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 2
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cuda-test",
      "configurePreset": "cuda-test",
      "filter": {
        "include": {
          "name": "^(atlas_tests|atlas_tests_interactive|atlas_tests_interactive_rendering)\\."
        }
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 1
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "tbb-test",
      "configurePreset": "tbb-test",
      "targets": [
        "atlas_tests",
        "atlas_tests_interactive",
        "atlas_tests_interactive_rendering",
        "atlas-interactive-app",
        "atlas-interactive-example",
        "atlas_benchmarks",
        "atlas_examples"
      ]
    },
    {
      "name": "cuda-test",
      "configurePreset": "cuda-test",
      "targets": [
        "atlas_tests",
        "atlas_tests_interactive",
        "atlas_tests_interactive_rendering",
        "atlas-interactive-app",
        "atlas-interactive-example",
        "atlas_benchmarks",
        "atlas_examples"
      ]
    }
  ]
}
