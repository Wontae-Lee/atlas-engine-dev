{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "tbb-debug",
      "displayName": "Atlas TBB Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ATLAS_USE_CUDA": "OFF",
        "ATLAS_USE_TBB": "ON",
        "ATLAS_USE_VIZKIT": "ON",
        "ATLAS_LOGGING": "ON",
        "ATLAS_GOOGLE_TEST": "ON",
        "ATLAS_CUDA_TEST": "OFF",
        "ATLAS_BENCHMARKS": "ON"
      }
    },
    {
      "name": "tbb-release",
      "displayName": "Atlas TBB Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ATLAS_USE_CUDA": "OFF",
        "ATLAS_USE_TBB": "ON",
        "ATLAS_USE_VIZKIT": "ON",
        "ATLAS_LOGGING": "ON",
        "ATLAS_GOOGLE_TEST": "ON",
        "ATLAS_CUDA_TEST": "OFF",
        "ATLAS_BENCHMARKS": "ON"
      }
    },

    {
      "name": "cuda-debug",
      "displayName": "Atlas CUDA Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ATLAS_USE_CUDA": "ON",
        "ATLAS_USE_TBB": "OFF",
        "ATLAS_USE_VIZKIT": "ON",
        "ATLAS_LOGGING": "ON",
        "ATLAS_GOOGLE_TEST": "OFF",
        "ATLAS_CUDA_TEST": "OFF",
        "ATLAS_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "cuda-release",
      "displayName": "Atlas CUDA Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ATLAS_USE_CUDA": "ON",
        "ATLAS_USE_TBB": "OFF",
        "ATLAS_USE_VIZKIT": "ON",
        "ATLAS_LOGGING": "ON",
        "ATLAS_GOOGLE_TEST": "OFF",
        "ATLAS_CUDA_TEST": "OFF",
        "ATLAS_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "cuda-debug-tests",
      "displayName": "Atlas CUDA Debug Tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ATLAS_USE_CUDA": "ON",
        "ATLAS_USE_TBB": "OFF",
        "ATLAS_USE_VIZKIT": "OFF",
        "ATLAS_LOGGING": "ON",
        "ATLAS_GOOGLE_TEST": "OFF",
        "ATLAS_CUDA_TEST": "ON",
        "ATLAS_BENCHMARKS": "OFF"
      }
    }
  ],

  "buildPresets": [
    { "name": "build-tbb-debug",       "displayName": "Build TBB Debug",       "configurePreset": "tbb-debug",       "jobs": 0 },
    { "name": "build-tbb-release",     "displayName": "Build TBB Release",     "configurePreset": "tbb-release",     "jobs": 0 },
    { "name": "build-cuda-debug",      "displayName": "Build CUDA Debug",      "configurePreset": "cuda-debug",      "jobs": 0 },
    { "name": "build-cuda-release",    "displayName": "Build CUDA Release",    "configurePreset": "cuda-release",    "jobs": 0 },
    { "name": "build-cuda-debug-tests","displayName": "Build CUDA Debug Tests","configurePreset": "cuda-debug-tests","jobs": 0 }
  ],

  "testPresets": [
    {
      "name": "ctest-tbb-debug",
      "displayName": "CTest (TBB Debug)",
      "configurePreset": "tbb-debug",
      "execution": { "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ctest-tbb-release",
      "displayName": "CTest (TBB Release)",
      "configurePreset": "tbb-release",
      "execution": { "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    }
  ]
}
